# Base URL of the VisionX backend API
VITE_API_BASE_URL=http://localhost:8000/api

# Max upload size shown to the user, in MB (should match backend limit)
VITE_MAX_UPLOAD_MB=25

# Google Sign-In (Google Identity Services). Create a Client ID at
# https://console.cloud.google.com/apis/credentials (Web application type,
# with this app's URL added under "Authorized JavaScript origins"), then
# paste it below. Without this, the Google button will show a clear
# "not configured" message instead of failing silently.
VITE_GOOGLE_CLIENT_ID=
